; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="really_small_gd_project"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TwitchListener="*uid://c1btu5ssn6l3o"
CommandParser="*uid://c8ceb4sc41or"
Constants="*uid://bxghw5gbjly7i"
Refs="*uid://ijdt71q8i238"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://localization/localization.en.translation", "res://localization/localization.ru.translation")
locale/locale_filter_mode=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
